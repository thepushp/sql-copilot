# ---------------------------------------
# Ollama
# ---------------------------------------

OLLAMA_BASE_URL=http://localhost:11434


# ---------------------------------------
# Cloud AI Providers
# ---------------------------------------

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

# Any OpenAI-compatible server (set the base URL in the app sidebar)
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------
# Optional
# ---------------------------------------

# Directory of Flyway *.sql migrations (marks dropped tables)
FLYWAY_MIGRATION_PATH=

# Embedding model (re-index after changing)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ---------------------------------------
# Development Database
# ---------------------------------------

# postgresql | mysql | mssql | sqlite | oracle
# (for sqlite, DEV_DB_NAME is the file path; for oracle, the service name)
DEV_DB_DRIVER=postgresql

DEV_DB_HOST=localhost

DEV_DB_PORT=5432

DEV_DB_NAME=

DEV_DB_USERNAME=

DEV_DB_PASSWORD=

DEV_DB_SCHEMA=public


# ---------------------------------------
# Test Database
# ---------------------------------------

TEST_DB_DRIVER=postgresql

TEST_DB_HOST=localhost

TEST_DB_PORT=5432

TEST_DB_NAME=

TEST_DB_USERNAME=

TEST_DB_PASSWORD=

TEST_DB_SCHEMA=public

# ---------------------------------------
# Logging and safety (all optional)
# ---------------------------------------

# Audit trail of questions and SQL (never result rows or passwords).
# Default: data/audit.log. Set to "off" to disable.
# SQL_COPILOT_AUDIT_LOG=data/audit.log

# Console log level: DEBUG, INFO, WARNING, ERROR
# SQL_COPILOT_LOG_LEVEL=INFO

# Allow generated SQL to read system catalogs (pg_catalog, information_schema...)
# SQL_COPILOT_ALLOW_SYSTEM_CATALOGS=1

